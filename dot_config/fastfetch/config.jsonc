{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/2.57.1/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 0,
      "right": 3,
    },
    "color": {
      "1": "#00daef",
      "2": "#4bf3c8",
    },
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 0,
    },
    "color": {
      "keys": "#00daef",
      "title": "#4bf3c8",
      "output": "#eef0f9",
      "separator": "#858b98",
    },
    "percent": {
      "color": {
        "green": "#4bf3c8",
        "yellow": "#fbc23b",
        "red": "#f4587e",
      },
    },
    "size": {
      "ndigits": 1,
    },
  },
  "modules": [
    {
      "type": "custom",
      "format": "   ╭───────────────────────────────────────────╮",
      "outputColor": "#545864",
    },
    {
      "type": "os",
      "key": "     {icon} OS      ",
      "format": "{name:-9}{?version-id} {version-id:-7}{?}{?arch} ({arch:6}){?}",
    },
    {
      "type": "host",
      "key": "      Device  ",
      "format": "{name:-27}",
    },
    {
      "type": "kernel",
      "key": "      Kernel  ",
      "format": "{sysname:-7} {release:-18}",
    },
    {
      "type": "packages",
      "key": "     󰏖 Packages",
      "format": "{all:10} total",
    },
    {
      "type": "terminal",
      "key": "     󰞷 Terminal",
      "format": "{pretty-name:-15}{?version} {version:-10}{?}",
    },
    {
      "type": "wm",
      "key": "     󱂬 WM      ",
      "format": "{pretty-name:-27}",
    },
    {
      "type": "custom",
      "format": "   ╰───────────────────────────────────────────╯",
      "outputColor": "#545864",
    },
    "break",
    {
      "type": "custom",
      "format": "   ╭───────────────────────────────────────────╮",
      "outputColor": "#545864",
    },
    {
      "type": "cpu",
      "key": "      CPU     ",
      "format": "{name:-27}",
    },
    {
      "type": "cpu",
      "key": "      Cores   ",
      "format": "{cores-physical:5}C/{cores-logical:5}T{?freq-max} @ {freq-max:8}{?}{/freq-max}{?freq-base} @ {freq-base:8}{?}{/}",
    },
    {
      "type": "gpu",
      "key": "      GPU     ",
      "format": "{name:-27}",
    },
    {
      "type": "gpu",
      "key": "      GPU Info",
      "format": "{?core-count}{core-count:6} cores{?}{/core-count}{type:-11}{/}{?platform-api} @ {platform-api:-8}{?}",
    },
    {
      "type": "memory",
      "key": "     󰍛 Memory  ",
    },
    {
      "type": "disk",
      "key": "     󰋊 Disk    ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "battery",
      "key": "     󰁹 Battery ",
      "format": "{capacity} ({status:-20})",
    },
    {
      "type": "display",
      "key": "     󰹑 Display ",
      "format": "{width}x{height} @ {refresh-rate} Hz",
    },
    {
      "type": "uptime",
      "key": "     󰅐 Uptime  ",
      "format": "{?days}{days}d {?}{hours}h {minutes}m",
    },
    {
      "type": "custom",
      "format": "   ╰───────────────────────────────────────────╯",
      "outputColor": "#545864",
    },
    "break",
    {
      "type": "custom",
      "format": "     {##4bf3c8}● {##00daef}● {##00daef}● {##ffd493}● {##acafff}● {##cc75f4}● {##f4587e}● {##fbc23b}●{#}",
    },
    "break",
  ],
}
