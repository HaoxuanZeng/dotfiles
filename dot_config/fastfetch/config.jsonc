{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "general": {
    "preload": {
      "lua": "dofile('/Users/zenghx/.config/fastfetch/format.lua')",
    },
  },
  "logo": {
    "type": "auto",
    "padding": {
      "top": 0,
      "right": 3,
    },
    "color": {
      "1": "#00daef",
      "2": "#4bf3c8",
    },
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 0,
    },
    "color": {
      "keys": "#00daef",
      "title": "#4bf3c8",
      "output": "#eef0f9",
      "separator": "#858b98",
    },
    "percent": {
      "color": {
        "green": "#4bf3c8",
        "yellow": "#fbc23b",
        "red": "#f4587e",
      },
    },
    "size": {
      "ndigits": 1,
    },
  },
  "modules": [
    {
      "type": "custom",
      "format": "lua:return ff_border(true)",
      "outputColor": "#545864",
    },
    {
      "type": "os",
      "key": "     {icon} OS      ",
      "format": "lua:local a = ...; return ff_pair(a.name, ' ' .. a.versionId .. ' (' .. a.arch .. ')')",
    },
    {
      "type": "host",
      "key": "      Device  ",
      "format": "lua:return ff_host(...)",
    },
    {
      "type": "kernel",
      "key": "      Kernel  ",
      "format": "lua:local a = ...; return ff_pair(a.sysname, ' ' .. a.release)",
    },
    {
      "type": "packages",
      "key": "     󰏖 Packages",
      "format": "{brew} brew / {brew-cask} cask",
    },
    {
      "type": "terminal",
      "key": "     󰞷 Terminal",
      "format": "lua:local a = ...; return ff_pair(a.prettyName, a.version ~= '' and (' ' .. a.version) or '')",
    },
    {
      "type": "wm",
      "key": "     󱂬 WM      ",
      "format": "lua:return ff_fit((...).prettyName)",
    },
    {
      "type": "custom",
      "format": "lua:return ff_border(false)",
      "outputColor": "#545864",
    },
    "break",
    {
      "type": "custom",
      "format": "lua:return ff_border(true)",
      "outputColor": "#545864",
    },
    {
      "type": "cpu",
      "key": "      CPU     ",
      "format": "lua:return ff_cpu(...)",
    },
    {
      "type": "gpu",
      "key": "      GPU     ",
      "format": "lua:return ff_gpu(...)",
    },
    {
      "type": "memory",
      "key": "     󰍛 Memory  ",
    },
    {
      "type": "disk",
      "key": "     󰋊 Disk    ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "battery",
      "key": "     󰁹 Battery ",
      "format": "{capacity} ({status:-20})",
    },
    {
      "type": "display",
      "key": "     󰹑 Display ",
      "format": "{width}x{height} @ {refresh-rate} Hz",
    },
    {
      "type": "uptime",
      "key": "     󰅐 Uptime  ",
      "format": "{?days}{days}d {?}{hours}h {minutes}m",
    },
    {
      "type": "custom",
      "format": "lua:return ff_border(false)",
      "outputColor": "#545864",
    },
    "break",
    {
      "type": "custom",
      "format": "     {##4bf3c8}● {##00daef}● {##00daef}● {##ffd493}● {##acafff}● {##cc75f4}● {##f4587e}● {##fbc23b}●{#}",
    },
    "break",
  ],
}
